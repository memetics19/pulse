# Server settings. See docs/configuration.md for every setting.
# Renamed in 3.0: API_PORT is now PULSE_PORT, SQLITE_PATH is now PULSE_DB and
# DATABASE_URL is now PULSE_DATABASE_URL. API_PORT and SQLITE_PATH still work
# until 4.0. DATABASE_URL is not read. PULSE_DB is the full database file path.
PULSE_PORT=8080
PULSE_DB=/data/pulse.db
PULSE_DATA_DIR=
PULSE_DATABASE_URL=
RESEND_API_KEY=
SLACK_WEBHOOK_URL=
# Mark session cookies Secure when Pulse is served over HTTPS.
PULSE_SECURE_COOKIES=
# Comma-separated origins allowed to call the API cross-origin. Empty sends no
# CORS headers.
PULSE_CORS_ORIGINS=
# Permit monitors to target private/internal addresses (homelab). Off by default.
PULSE_ALLOW_PRIVATE_MONITORS=
# Comma-separated CIDRs of reverse proxies whose X-Forwarded-For may be trusted
# for the login rate limiter. Set when running behind a proxy (e.g. Caddy/Docker)
# so per-client throttling works instead of collapsing all visitors into one
# bucket. Leave empty to ignore proxy headers entirely.
PULSE_TRUSTED_PROXIES=
