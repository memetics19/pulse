#!/bin/sh
# pulse package: the service user, then start (first install) or restart (upgrade).
set -e
if ! getent passwd pulse >/dev/null; then
  useradd --system --user-group --home-dir /var/lib/pulse --no-create-home \
    --shell /usr/sbin/nologin pulse
fi
chown root:pulse /etc/pulse/pulse.env
chmod 0640 /etc/pulse/pulse.env
if [ -d /run/systemd/system ]; then
  systemctl daemon-reload
  systemctl enable pulse.service >/dev/null 2>&1
  systemctl restart pulse.service
  # An env file kept from before 3.0 may still say API_PORT.
  port=$(sed -n 's/^PULSE_PORT=//p' /etc/pulse/pulse.env)
  [ -n "$port" ] || port=$(sed -n 's/^API_PORT=//p' /etc/pulse/pulse.env)
  [ -n "$port" ] || port=8080
  datadir=$(sed -n 's/^PULSE_DATA_DIR=//p' /etc/pulse/pulse.env)
  [ -n "$datadir" ] || datadir=/var/lib/pulse
  if [ ! -f "${datadir}/pulse.json" ]; then
    echo "pulse: running on port ${port}. Finish setup at http://localhost:${port}/setup"
    echo "pulse: the wizard asks for the setup token in the log:"
    echo "  sudo journalctl -u pulse | grep \"setup token\" | tail -n 1"
  else
    echo "pulse: running on port ${port}."
  fi
fi
