# Settings for the pulse service (see https://docs.shreeda.xyz/configuration/).
# Restart after a change: sudo systemctl restart pulse
PULSE_PORT=8080
PULSE_DB=/var/lib/pulse/pulse.db
PULSE_DATA_DIR=/var/lib/pulse
# true when Pulse is served over HTTPS (marks session cookies Secure).
PULSE_SECURE_COOKIES=false
# true lets monitors reach private and LAN addresses (homelabs).
PULSE_ALLOW_PRIVATE_MONITORS=false
RESEND_API_KEY=
PULSE_EMAIL_FROM=
# Email alerts through an SMTP relay instead of Resend. SMTP wins when both
# are set. PULSE_SMTP_TLS is starttls (default), tls, or none (localhost only).
PULSE_SMTP_HOST=
PULSE_SMTP_PORT=
PULSE_SMTP_USER=
PULSE_SMTP_PASSWORD=
PULSE_SMTP_PASSWORD_FILE=
PULSE_SMTP_TLS=
SLACK_WEBHOOK_URL=
# Daily database snapshots. Empty turns them off. The service can only write
# under /var/lib/pulse, so use a directory there, such as /var/lib/pulse/backups.
# PULSE_BACKUP_KEEP is how many to keep (default 7).
PULSE_BACKUP_DIR=
PULSE_BACKUP_KEEP=
