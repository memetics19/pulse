# Settings for the pulse service (see https://docs.shreeda.xyz/configuration/).
# Restart after a change: sudo systemctl restart pulse
PULSE_PORT=8080
PULSE_DB=/var/lib/pulse/pulse.db
PULSE_DATA_DIR=/var/lib/pulse
# true when Pulse is served over HTTPS (marks session cookies Secure).
PULSE_SECURE_COOKIES=false
# true lets monitors reach private and LAN addresses (homelabs).
PULSE_ALLOW_PRIVATE_MONITORS=false
RESEND_API_KEY=
PULSE_EMAIL_FROM=
SLACK_WEBHOOK_URL=
